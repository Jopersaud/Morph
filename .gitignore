# Generated by XcodeGen from project.yml — never commit it (SPEC §2).
*.xcodeproj
*.xcworkspace

# Local signing overrides: holds your DEVELOPMENT_TEAM (SPEC §13).
Local.xcconfig

# Build output
build/
.build/
DerivedData/
*.o
*.dSYM/

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager. Local path dependencies need no lockfile; when a
# remote dependency arrives (swift-argument-parser in M6), commit its
# Package.resolved instead of ignoring it.
.swiftpm/
Packages/**/Package.resolved

# Vendored binaries: built by Vendor/scripts, not committed (SPEC §6).
Vendor/build/
Vendor/**/*.xcframework
Vendor/**/*.a
Vendor/**/*.dylib

# Generated at build time from the bundled libraries' licenses (SPEC §8).
THIRD_PARTY_NOTICES.md

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp
