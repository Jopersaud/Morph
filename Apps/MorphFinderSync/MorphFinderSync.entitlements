<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Finder Sync extensions must be sandboxed (SPEC §7), which is why this one
	only builds menus and hands the work to the app.

	Read-only access to the user's selection is enough: the extension never
	writes a file. No network entitlements, here or anywhere.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
