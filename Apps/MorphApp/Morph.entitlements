<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The main app is deliberately NOT sandboxed (SPEC §7). It writes output
	beside arbitrary source files, and the sandbox would ask for folder access
	every time. Hardened Runtime is on instead.

	There are no network entitlements here, and there never will be:
	Scripts/network-guard.sh fails the build if one appears.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
